# Copie para .env e preencha. Nunca commite o .env de verdade.
# Se for rodar via GitHub Actions, cole os mesmos valores como "Secrets"
# do repositorio (Settings > Secrets and variables > Actions) em vez de
# usar um arquivo .env - ver README.

# --- Roteiro (LLM) - gratis, sem cartao (Groq) ---
# Crie em: https://console.groq.com/keys
GROQ_API_KEY=

# --- Voz (TTS) - edge-tts nao precisa de chave, so a variavel de voz ---
EDGE_TTS_VOICE=pt-BR-AntonioNeural

# --- YouTube (OAuth - gratis, ver upload.py) ---
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json

# --- Notificacao por e-mail (opcional, Gmail + senha de app e gratis) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=voce@gmail.com
SMTP_PASSWORD=app-password-aqui
NOTIFY_TO_EMAIL=voce@gmail.com
